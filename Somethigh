shared.FrixRewriteCleanup = function()
	stopPlayerFeatures()
	stopNpcEsp()
	stopInstantKill()
	stopInstantKillNoHit()
	for _, connection in ipairs(connections) do
		disconnect(connection)
	end
	connections = {}
	if gui and gui.Parent then
		gui:Destroy()
	end
end

