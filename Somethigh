local connections = {}
local function connect(connection)
	table.insert(connections, connection)
	return connection
end

local function disconnect(connection)
	if connection and connection.Connected then
		connection:Disconnect()
	end
end

local function getCharacter()
	return LocalPlayer.Character
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function stopPlayerFeatures()
	state.fly = false
	state.walkSpeed = false
	state.jumpPower = false
	state.gravity = false
	state.noclip = false
	state.infiniteJump = false

	Workspace.Gravity = 196.2

	local humanoid = getHumanoid()
	if humanoid then
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50
	end

	for _, part in ipairs(getCharacter() and getCharacter():GetDescendants() or {}) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end
end

local espConnection
local espHealthConnections = {}
local espRetrying = {}
local applyNpcHighlight

local function retryNpcEsp(model)
	if espRetrying[model] then return end
	espRetrying[model] = true

	task.spawn(function()
		for _ = 1, 20 do
			if not state.npcEsp or not model.Parent then break end
			task.wait(0.15)
			applyNpcHighlight(model)
			if model:FindFirstChild("FriXRewriteHealth") then break end
		end
		espRetrying[model] = nil
	end)
end

applyNpcHighlight = function(model)
	if not model:IsA("Model") then return end
	local humanoid = model:FindFirstChildWhichIsA("Humanoid", true)
	if not humanoid then
		retryNpcEsp(model)
		return
end

	local highlight = model:FindFirstChild("FriXRewriteHighlight")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "FriXRewriteHighlight"
		highlight.Parent = model
	end

	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(255, 235, 70)
	highlight.FillTransparency = 0.35
	highlight.OutlineColor = Color3.fromRGB(255, 170, 20)
	highlight.OutlineTransparency = 0

	local adornee = model:FindFirstChild("Head")
		or model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChildWhichIsA("BasePart", true)
	if not adornee then
		retryNpcEsp(model)
		return
	end

	local billboard = model:FindFirstChild("FriXRewriteHealth")
	if not billboard then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "FriXRewriteHealth"
		billboard.Size = UDim2.fromOffset(130, 28)
		billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 10000
		billboard.Parent = model
	end
	billboard.Adornee = adornee

	local healthLabel = billboard:FindFirstChild("HealthLabel")
	if not healthLabel then
		healthLabel = Instance.new("TextLabel")
		healthLabel.Name = "HealthLabel"
		healthLabel.Size = UDim2.fromScale(1, 1)
		healthLabel.BackgroundTransparency = 1
		healthLabel.Font = Enum.Font.SourceSansBold
		healthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		healthLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		healthLabel.TextStrokeTransparency = 0
		healthLabel.TextSize = 16
		healthLabel.Parent = billboard
	end

	local function updateHealthText(health)
		healthLabel.Text = string.format("HP: %d / %d", math.max(0, math.floor(health + 0.5)), math.floor(humanoid.MaxHealth + 0.5))
	end

	updateHealthText(humanoid.Health)
	if not espHealthConnections[humanoid] then
		espHealthConnections[humanoid] = humanoid.HealthChanged:Connect(updateHealthText)
	end
	espRetrying[model] = nil
end

local function stopNpcEsp()
	state.npcEsp = false
	disconnect(espConnection)
	espConnection = nil
	for humanoid, connection in pairs(espHealthConnections) do
		disconnect(connection)
		espHealthConnections[humanoid] = nil
	end

	local ai = Workspace:FindFirstChild("AI")
	if ai then
		for _, model in ipairs(ai:GetChildren()) do
			local highlight = model:FindFirstChild("FriXRewriteHighlight")
			if highlight then highlight:Destroy() end
			local healthDisplay = model:FindFirstChild("FriXRewriteHealth")
			if healthDisplay then healthDisplay:Destroy() end
		end
	end
end

local function startNpcEsp()
	if espConnection then return end
	state.npcEsp = true

	local ai = Workspace:FindFirstChild("AI")
	if not ai then return end

	for _, model in ipairs(ai:GetChildren()) do
		applyNpcHighlight(model)
	end

	espConnection = connect(ai.ChildAdded:Connect(function(model)
		if state.npcEsp then applyNpcHighlight(model) end
	end))
end

local killConnection
local killHealthConnections = {}
local killHealthSnapshot = {}
local stopInstantKill
local stopInstantKillNoHit

local function forEachNpcHumanoid(callback)
	local ai = Workspace:FindFirstChild("AI")
	if not ai then return end

	for _, humanoid in ipairs(ai:GetDescendants()) do
		if humanoid:IsA("Humanoid") then
			callback(humanoid)
		end
	end
end

stopInstantKill = function()
	state.instantKill = false
	disconnect(killConnection)
	killConnection = nil

	for humanoid, connection in pairs(killHealthConnections) do
		disconnect(connection)
		killHealthConnections[humanoid] = nil
	end
	killHealthSnapshot = {}
end

local function startInstantKill()
	if killConnection then return end
	stopInstantKillNoHit()
	state.instantKill = true

	killConnection = connect(RunService.Heartbeat:Connect(function()
		if not state.instantKill then return end

		forEachNpcHumanoid(function(humanoid)
			pcall(function()
				if not humanoid:IsA("Humanoid") then return end
				local model = humanoid.Parent
				if not model or Players:GetPlayerFromCharacter(model) then return end

				local health = humanoid.Health
				killHealthSnapshot[humanoid] = killHealthSnapshot[humanoid] or health

				if not killHealthConnections[humanoid] then
					killHealthConnections[humanoid] = humanoid.HealthChanged:Connect(function(newHealth)
						local previousHealth = killHealthSnapshot[humanoid]
						killHealthSnapshot[humanoid] = newHealth
						if previousHealth and newHealth < previousHealth then
							pcall(function() humanoid.Health = 0 end)
						end
					end)
				end

				if humanoid:GetState() == Enum.HumanoidStateType.Dead and health > 0 then
					humanoid.Health = 0
				end
			end)
		end)
	end))
end

local instantKillNoHitConnection
stopInstantKillNoHit = function()
	state.instantKillNoHit = false
	disconnect(instantKillNoHitConnection)
	instantKillNoHitConnection = nil
end

local function startInstantKillNoHit()
	if instantKillNoHitConnection then return end
	stopInstantKill()
	state.instantKillNoHit = true

	instantKillNoHitConnection = connect(RunService.Heartbeat:Connect(function()
		if not state.instantKillNoHit then return end

		forEachNpcHumanoid(function(humanoid)
			pcall(function()
				if not humanoid:IsA("Humanoid") or humanoid.Health <= 0 then return end
				local model = humanoid.Parent
				if model and not Players:GetPlayerFromCharacter(model) then
					humanoid.Health = 0
				end
			end)
		end)
	end))
end

