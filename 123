local Players = game:GetService("Players")
local player = Players.LocalPlayer
local newName = "R34.XYZ"
local shared = (getgenv and getgenv()) or _G

if shared.nameTagWatcher then
	shared.nameTagWatcher:Disconnect()
end

if shared.nameTagCharacterWatcher then
	shared.nameTagCharacterWatcher:Disconnect()
end

local function changeNameTag(object)
	if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
		return
	end

	if object.Name == "PlayerName" or object.Text == player.Name or object.Text == player.DisplayName then
		object.Text = newName
	end
end

local function watchCharacter(character)
	if shared.nameTagWatcher then
		shared.nameTagWatcher:Disconnect()
	end

	for _, object in ipairs(character:GetDescendants()) do
		changeNameTag(object)
	end

	shared.nameTagWatcher = character.DescendantAdded:Connect(function(object)
		task.defer(changeNameTag, object)
	end)
end

if player.Character then
	watchCharacter(player.Character)
end

shared.nameTagCharacterWatcher = player.CharacterAdded:Connect(watchCharacter)
